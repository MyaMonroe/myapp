# Required: long random token used by AKUJI Android to authenticate to the bridge.
AKUJI_BRIDGE_TOKEN=

# Harness selection. Use "hermes" for the Hermes Agent API server.
AKUJI_HARNESS_KIND=hermes

# Hermes gateway API server base URL, for example http://127.0.0.1:8642
AKUJI_HARNESS_BASE_URL=

# Required when AKUJI_HARNESS_KIND=hermes. This is Hermes API_SERVER_KEY.
AKUJI_HARNESS_TOKEN=

# Only used for a non-Hermes generic harness.
AKUJI_HARNESS_TASK_PATH=

# Keep false until the sandbox is tested. Dry-run/research tasks remain allowed.
AKUJI_BRIDGE_ALLOW_EXECUTION=false
