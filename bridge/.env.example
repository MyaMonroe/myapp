# Required: long random token used by AKUJI Android to authenticate to the bridge.
AKUJI_BRIDGE_TOKEN=

# Optional Picsart Creative API key. Keep it ONLY on the bridge host.
# Never commit the real key and never hardcode it in the Android APK.
PICSART_API_KEY=

# Keep false until a specific external tool action is intentionally enabled.
AKUJI_BRIDGE_ALLOW_EXECUTION=false
