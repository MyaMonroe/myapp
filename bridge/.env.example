# Required: long random token used by AKUJI Android to authenticate to the bridge.
AKUJI_BRIDGE_TOKEN=

# Optional until the Qwen/sandbox service is deployed.
AKUJI_HARNESS_BASE_URL=
AKUJI_HARNESS_TASK_PATH=
AKUJI_HARNESS_TOKEN=

# Keep false until the sandbox is tested. Dry-run/research tasks remain allowed.
AKUJI_BRIDGE_ALLOW_EXECUTION=false
